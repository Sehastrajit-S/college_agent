# Environment files (keep the documented template)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Test, coverage, build, and packaging output
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/
.eggs/

# Google OAuth client secrets and user tokens (keep the safe example)
/credentials*.json
!/credentials.example.json
/client_secret*.json
/token*.json
/secrets/
/.secrets/

# Generated application data may contain private email content
/output/
*.log

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
