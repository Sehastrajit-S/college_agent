# Copy this file to .env. Never commit the completed .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Relative paths are resolved from the repository root.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Optional fallback. config.json or an /api/run request can override this.
GMAIL_QUERY=from:notifications@instructure.com
